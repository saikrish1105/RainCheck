{
  "manifest_version": 3,
  "name": "RainCheck",
  "version": "0.2.0",
  "description": "See your Claude.ai session and weekly usage, and generate a clean markdown handoff summary so you can continue your conversation anywhere.",
  "host_permissions": ["https://claude.ai/*"],
  "action": {
    "default_title": "RainCheck",
    "default_popup": "src/options/popup.html",
    "default_icon": {
      "16": "src/assets/cloud.png",
      "48": "src/assets/cloud.png",
      "128": "src/assets/cloud.png"
    }
  },
  "icons": {
    "16": "src/assets/cloud.png",
    "48": "src/assets/cloud.png",
    "128": "src/assets/cloud.png"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://*.claude.ai/*"],
      "js": ["src/content/isolated.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/assets/cloud.png", "src/injected/bridge.js"],
      "matches": ["https://claude.ai/*"]
    }
  ]
}
